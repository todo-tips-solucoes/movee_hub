[Unit]
Description=Verifica o PostgREST de produção a cada 5 minutos

[Timer]
# 5 min: o incidente de 2026-11-20 derrubou TODOS os logins e ficou 1h45 sem
# ninguém saber. Cada execução é um `docker logs --since 5m` — custo desprezível.
OnCalendar=*:0/5
Persistent=true
AccuracySec=30s

[Install]
WantedBy=timers.target
