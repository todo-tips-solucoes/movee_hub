# =============================================================================
# Hub — DEV — TEMPLATE (sem segredos; §4.8)
# Real em /var/lib/hub_secrets/.env.hub.dev (chmod 600), via gen-secrets.sh.
# =============================================================================

APP_ENV=development

HUB_DB_NAME=hub_dev
HUB_DB_USER=hub_dev
HUB_DB_PASSWORD=__GERAR__

PGRST_JWT_SECRET=__GERAR__
# JWT_*/POSTGREST_API_KEY/URLs/ENVIO_*: consumidos pela APP a partir da S2 —
# em S1 só o preflight os valida/fingerprinta (nenhum serviço os lê ainda)
JWT_SECRET=__GERAR__
JWT_REFRESH_SECRET=__GERAR__
POSTGREST_API_KEY=__GERAR__

# URLs internas/localhost (dev publica só em 127.0.0.1: 14801–14803)
POSTGREST_URL=http://postgrest:3000
FASTAPI_URL=http://fastapi-mock:8080
N8N_URL=http://n8n-mock:8080
MAIL_MOCK_URL=http://mailpit-mock:8080

N8N_API_TOKEN=hub-dev-mock-n8n-token
FASTAPI_VALIDATION_TOKEN=hub-dev-mock-fastapi-token

ENVIO_DRY_RUN=true
ENVIO_REAL_HABILITADO=false
ENVIO_ALLOWLIST=
ENVIO_MAX_MENSAGENS=10

# Chave VAPID (Web Push) — arquivo gerado por infra/hub/scripts/gen-vapid.sh,
# nunca o valor em si (FR-025). Ausente/inválido => push 503 PUSH_INDISPONIVEL.
VAPID_KEYS_FILE=/var/lib/hub_secrets/vapid.dev.json

# Allowlist de hosts do endpoint de inscrição push (research.md Decision 10/
# 14, lib/hub-push-endpoint.js — FASE 2): a lista padrão embutida no código
# (fcm.googleapis.com, updates.push.services.mozilla.com, *.push.apple.com,
# *.notify.windows.com) só é SUBSTITUÍDA por este override quando
# ENVIO_ALLOWLIST acima também está definida — mesmo gate de saída do envio
# em massa serve de trava (produção nunca define nenhuma das duas). Vazio
# aqui = allowlist padrão embutida vale.
PUSH_HOSTS_PERMITIDOS=
