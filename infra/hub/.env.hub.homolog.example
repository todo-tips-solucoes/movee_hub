# =============================================================================
# Hub — HOMOLOGAÇÃO — TEMPLATE (sem segredos; §4.8)
# O arquivo REAL fica em /var/lib/hub_secrets/.env.hub.homolog (chmod 600),
# gerado por infra/hub/scripts/gen-secrets.sh — JAMAIS no git.
# Placeholders __GERAR__ são preenchidos pelo gen-secrets.sh com valores novos
# (nunca copiados de produção).
# =============================================================================

# Identificação do ambiente (obrigatório; preflight aborta se ausente)
APP_ENV=homologation

# Domínio e portas do Traefik do hub (portas altas; 80/443 são da produção)
HUB_DOMAIN=hub-homolog.todo-tips.com
HUB_HTTP_PORT=8880
HUB_HTTPS_PORT=8443

# Certificado TLS (self-signed gerado pelo gen-secrets.sh; ver RUNBOOK §TLS)
HUB_TLS_DIR=/var/lib/hub_secrets/tls

# Banco exclusivo do hub (postgres:13; §4.6). Porta NUNCA publicada.
HUB_DB_NAME=hub_homolog
HUB_DB_USER=hub_homolog
HUB_DB_PASSWORD=__GERAR__

# PostgREST próprio (v14.1) — segredo NOVO, nunca o de produção
PGRST_JWT_SECRET=__GERAR__

# Credenciais da aplicação do hub (S2+) — todas novas (§4.4)
JWT_SECRET=__GERAR__
JWT_REFRESH_SECRET=__GERAR__
POSTGREST_API_KEY=__GERAR__

# URLs internas (rede hub_homolog_net; jamais URL pública de produção)
POSTGREST_URL=http://postgrest:3000
FASTAPI_URL=http://fastapi-mock:8080
N8N_URL=http://n8n-mock:8080

# Tokens de mock (valores dummy; os de produção NUNCA são copiados — §4.7)
N8N_API_TOKEN=hub-homolog-mock-n8n-token
FASTAPI_VALIDATION_TOKEN=hub-homolog-mock-fastapi-token

# Proteções do envio em massa (§4.7 itens 1–5; default fail-safe).
# Consumidas pela APP a partir da S2 — o limite/allowlist ainda NÃO é
# enforçado por nenhum serviço em S1 (hoje o preflight valida o env).
ENVIO_DRY_RUN=true
ENVIO_REAL_HABILITADO=false
ENVIO_ALLOWLIST=
ENVIO_MAX_MENSAGENS=10
