BACKEND_URL=https://your-backend-host

# hub-shell (S3): identifica o ambiente para o EnvBadge (banner "HOMOLOGAÇÃO —
# dados fictícios" + favicon alternativo). Só o valor exato "production"
# esconde o aviso — qualquer outro valor, ou a ausência da variável, é
# fail-safe e MOSTRA o aviso (CHK029). Pública (NEXT_PUBLIC_) e inlineada no
# build do Next — precisa estar definida no ambiente de BUILD da imagem.
NEXT_PUBLIC_APP_ENV=homologacao
